# ============================================================
#  JM FACTURACIÓN — Variables de entorno
# ------------------------------------------------------------
#  Copia este archivo como `.env.local` y rellena los valores.
#  NUNCA subas `.env.local` al repositorio (ya está en .gitignore).
#  El `service_role` es SOLO de servidor: jamás con prefijo
#  NEXT_PUBLIC_ y jamás expuesto al navegador (Estándar Fort Knox).
# ============================================================

# --- Públicas (seguras para el navegador) ---
# URL del proyecto Supabase, ej: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima/publishable de Supabase (protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Privadas (SOLO servidor — nunca exponer) ---
# Clave service_role: acceso total, se salta RLS. Uso exclusivo en
# el servidor (migraciones, tareas administrativas). JAMÁS al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (para enlaces, redirecciones de auth y PDFs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
